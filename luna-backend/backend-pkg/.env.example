PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/luna_db

# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/luna_db?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=30d

# ─── ML Microservice ────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5001

# ─── LLM (Gemini AI) ───────────────────────────────────────────
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
